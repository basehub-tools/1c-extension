// Агент Basehub (клиент): если 1С запущена из Basehub с параметром «bh-agent=<порт>:<ключ>»,
// сеанс раз в секунду спрашивает у Basehub команду (127.0.0.1), выполняет её на сервере
// модулем bh_Basehub и отправляет ответ. Без параметра запуска ничего не делает.

Перем bh_Порт;
Перем bh_Ключ;
Перем bh_Ошибок;
Перем bh_Сеанс;

&После("ПриНачалеРаботыСистемы")
Процедура bh_ПриНачалеРаботыСистемы()
	Позиция = СтрНайти(ПараметрЗапуска, "bh-agent=");
	Если Позиция = 0 Тогда
		Возврат;
	КонецЕсли;
	Значение = Сред(ПараметрЗапуска, Позиция + СтрДлина("bh-agent="));
	Конец = СтрНайти(Значение, ";");
	Если Конец > 0 Тогда
		Значение = Лев(Значение, Конец - 1);
	КонецЕсли;
	Части = СтрРазделить(СокрЛП(Значение), ":");
	Если Части.Количество() <> 2 Тогда
		Возврат;
	КонецЕсли;
	bh_Порт = Число(Части[0]);
	bh_Ключ = Части[1];
	bh_Ошибок = 0;
	bh_Basehub.ЗаписатьВЖурнал("Агент Basehub подключается к Basehub на этом компьютере (порт " + Формат(bh_Порт, "ЧГ=0") + ")");
	// описание сеанса — URL-безопасным Base64 (КодироватьСтроку нет в режиме совместимости 8.3.10)
	bh_Сеанс = Base64Строка(ПолучитьДвоичныеДанныеИзСтроки(bh_Basehub.ОписаниеСеанса(), КодировкаТекста.UTF8));
	bh_Сеанс = СтрЗаменить(СтрЗаменить(СтрЗаменить(СтрЗаменить(СтрЗаменить(bh_Сеанс, Символы.ВК, ""), Символы.ПС, ""), "+", "-"), "/", "_"), "=", "");
	ПодключитьОбработчикОжидания("bh_АгентОпрос", 1);
КонецПроцедуры

Процедура bh_АгентОпрос() Экспорт
	Попытка
		Соединение = Новый HTTPСоединение("127.0.0.1", bh_Порт, , , , 5);
		Ответ = Соединение.Получить(Новый HTTPЗапрос("/bh/poll?t=" + bh_Ключ + "&s=" + bh_Сеанс));
		bh_Ошибок = 0;
		Если Ответ.КодСостояния <> 200 Тогда
			Возврат;
		КонецЕсли;
		Строки = СтрРазделить(Ответ.ПолучитьТелоКакСтроку("UTF-8"), Символы.ПС);
		Идентификатор = Строки[0];
		Данные = "";
		Если Строки.Количество() > 2 И Строки[2] <> "" Тогда
			Данные = ПолучитьСтрокуИзДвоичныхДанных(Base64Значение(Строки[2]), КодировкаТекста.UTF8);
		КонецЕсли;
		Результат = bh_Basehub.ВыполнитьКомандуАгента(Строки[1], Данные);
		Запрос = Новый HTTPЗапрос("/bh/result?t=" + bh_Ключ + "&id=" + Идентификатор);
		Запрос.УстановитьТелоИзСтроки(Результат, КодировкаТекста.UTF8, ИспользованиеByteOrderMark.НеИспользовать);
		Соединение.ОтправитьДляОбработки(Запрос);
	Исключение
		// Basehub закрыт — после минуты неудач перестаём опрашивать
		bh_Ошибок = bh_Ошибок + 1;
		Если bh_Ошибок = 1 Тогда
			bh_Basehub.ЗаписатьВЖурнал("Агент Basehub: " + КраткоеПредставлениеОшибки(ИнформацияОбОшибке()), Истина);
		КонецЕсли;
		Если bh_Ошибок > 60 Тогда
			ОтключитьОбработчикОжидания("bh_АгентОпрос");
		КонецЕсли;
	КонецПопытки;
КонецПроцедуры