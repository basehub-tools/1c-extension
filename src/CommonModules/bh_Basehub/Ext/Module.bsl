// Расширение Basehub: связь редактора Basehub с базой (внешнее соединение / COM).
// Консоль кода, консоль запросов, метаданные для подсказок, журнал регистрации.
// Код, запросы и журнал — только для пользователей с правом «Администрирование».

Функция Версия() Экспорт
	Возврат "1.0.0";
КонецФункции

// Запись агента в журнал регистрации (с клиента ЗаписьЖурналаРегистрации недоступна).
Процедура ЗаписатьВЖурнал(Знач Текст, Знач Ошибка = Ложь) Экспорт
	ЗаписьЖурналаРегистрации("Basehub.Агент", ?(Ошибка, УровеньЖурналаРегистрации.Ошибка, УровеньЖурналаРегистрации.Информация), , , Текст);
КонецПроцедуры

// База и пользователь — для строки состояния Basehub.
Функция ОписаниеСеанса() Экспорт
	Возврат Метаданные.Синоним + " · " + ИмяПользователя();
КонецФункции

// Команда агента из клиентского сеанса: code / query (JSON {text, params, limit}) / meta.
// Ошибка — строкой с префиксом «ERR:».
Функция ВыполнитьКомандуАгента(Знач Операция, Знач Данные) Экспорт
	Попытка
		Если Операция = "code" Тогда
			// в клиентский сеанс — без управляющих символов: строка с Символ(1) роняет тонкий клиент
			Части = СтрРазделить(ВыполнитьКодВФоне(Данные), Символ(1), Истина);
			Запись = Новый ЗаписьJSON;
			Запись.УстановитьСтроку();
			Запись.ЗаписатьНачалоОбъекта();
			Запись.ЗаписатьИмяСвойства("ms");
			Запись.ЗаписатьЗначение(Число("0" + Части[0]));
			Запись.ЗаписатьИмяСвойства("error");
			Запись.ЗаписатьЗначение(?(Части.Количество() > 1, СокрЛП(Части[1]), ""));
			Запись.ЗаписатьИмяСвойства("output");
			Запись.ЗаписатьЗначение(?(Части.Количество() > 2, СокрП(Части[2]), ""));
			Запись.ЗаписатьКонецОбъекта();
			Возврат Запись.Закрыть();
		ИначеЕсли Операция = "query" Тогда
			Чтение = Новый ЧтениеJSON;
			Чтение.УстановитьСтроку(Данные);
			Запрос = ПрочитатьJSON(Чтение, Истина);
			Чтение.Закрыть();
			Возврат ВыполнитьЗапрос(Запрос.Получить("text"), Запрос.Получить("params"), Запрос.Получить("limit"));
		ИначеЕсли Операция = "meta" Тогда
			Возврат МетаданныеJSON();
		КонецЕсли;
		Возврат "ERR:неизвестная команда " + Операция;
	Исключение
		Возврат "ERR:" + КраткоеПредставлениеОшибки(ИнформацияОбОшибке());
	КонецПопытки;
КонецФункции
Процедура ПроверитьПрава()
	Если НЕ ПравоДоступа("Администрирование", Метаданные) Тогда
		ВызватьИсключение "Basehub: нужно право «Администрирование»";
	КонецЕсли;
КонецПроцедуры

// Выполнить фрагмент кода. Ответ: «мс␁ошибка␁вывод» (␁ — Символ(1)).
// Значение переменной Результат, если код её заполнил, — последней строкой вывода.
// СобратьСообщения = Ложь — для клиентского сеанса (агент): сообщения уйдут на клиент сами.
Функция ВыполнитьКод(Знач Код__, Знач СобратьСообщения__ = Истина) Экспорт
	ПроверитьПрава();
	Результат = Неопределено;
	Начало__ = ТекущаяУниверсальнаяДатаВМиллисекундах();
	Ошибка__ = "";
	Попытка
		Выполнить(Код__);
	Исключение
		Ошибка__ = ПодробноеПредставлениеОшибки(ИнформацияОбОшибке());
	КонецПопытки;
	Мс__ = ТекущаяУниверсальнаяДатаВМиллисекундах() - Начало__;
	Вывод__ = "";
	Если СобратьСообщения__ Тогда
		Для Каждого С__ Из ПолучитьСообщенияПользователю(Истина) Цикл
			Вывод__ = Вывод__ + С__.Текст + Символы.ПС;
		КонецЦикла;
	КонецЕсли;
	Если Результат <> Неопределено Тогда
		Вывод__ = Вывод__ + "Результат = " + Строка(Результат) + " (" + Строка(ТипЗнч(Результат)) + ")" + Символы.ПС;
	КонецЕсли;
	Возврат Формат(Мс__, "ЧГ=0") + Символ(1) + Ошибка__ + Символ(1) + Вывод__;
КонецФункции

// Код из клиентского сеанса (агент) — фоновым заданием: Выполнить() в серверном вызове из сеанса
// тонкого клиента роняет его «непредвиденной ошибкой»; заодно окно 1С не замирает, а сообщения
// Сообщить() забираются у задания.
Функция ВыполнитьКодВФоне(Знач Код) Экспорт
	ПроверитьПрава();
	Адрес = ПоместитьВоВременноеХранилище(Неопределено, Новый УникальныйИдентификатор);
	Параметры = Новый Массив;
	Параметры.Добавить(Код);
	Параметры.Добавить(Адрес);
	Задание = ФоновыеЗадания.Выполнить("bh_Basehub.ВыполнитьКодЗадания", Параметры, , "Basehub: консоль кода");
	Ожидание = Новый Массив;
	Ожидание.Добавить(Задание);
	Попытка
		ФоновыеЗадания.ОжидатьЗавершения(Ожидание);
	Исключение
		// ошибка внутри задания — её текст в ИнформацияОбОшибке задания
	КонецПопытки;
	Задание = ФоновыеЗадания.НайтиПоУникальномуИдентификатору(Задание.УникальныйИдентификатор);
	Ответ = ПолучитьИзВременногоХранилища(Адрес);
	Вывод = "";
	Для Каждого Сообщение Из Задание.ПолучитьСообщенияПользователю(Истина) Цикл
		Вывод = Вывод + Сообщение.Текст + Символы.ПС;
	КонецЦикла;
	Если ТипЗнч(Ответ) <> Тип("Строка") Тогда
		Ошибка = ?(Задание.ИнформацияОбОшибке = Неопределено, "Фоновое задание не вернуло результат", ПодробноеПредставлениеОшибки(Задание.ИнформацияОбОшибке));
		Возврат "0" + Символ(1) + Ошибка + Символ(1) + Вывод;
	КонецЕсли;
	Части = СтрРазделить(Ответ, Символ(1), Истина);
	Если Части.Количество() = 3 Тогда
		Возврат Части[0] + Символ(1) + Части[1] + Символ(1) + Вывод + Части[2];
	КонецЕсли;
	Возврат Ответ;
КонецФункции

Процедура ВыполнитьКодЗадания(Знач Код, Знач Адрес) Экспорт
	ПоместитьВоВременноеХранилище(ВыполнитьКод(Код, Ложь), Адрес);
КонецПроцедуры
// Выполнить запрос. ПараметрыJSON — объект {"Имя": значение}; строки вида «2026-10-17T00:00:00» — даты.
// Ответ — JSON: {ms, total, columns: [{name, type}], rows: [[представления]], error}.
Функция ВыполнитьЗапрос(Знач Текст, Знач ПараметрыJSON = "", Знач Лимит = 1000) Экспорт
	ПроверитьПрава();
	Запись = Новый ЗаписьJSON;
	Запись.УстановитьСтроку();
	Запись.ЗаписатьНачалоОбъекта();
	Попытка
		Запрос = Новый Запрос(Текст);
		Если ТипЗнч(ПараметрыJSON) = Тип("Строка") И ПараметрыJSON <> "" Тогда
			Чтение = Новый ЧтениеJSON;
			Чтение.УстановитьСтроку(ПараметрыJSON);
			Параметры = ПрочитатьJSON(Чтение, Истина);
			Чтение.Закрыть();
			Для Каждого КЗ Из Параметры Цикл
				Запрос.УстановитьПараметр(КЗ.Ключ, ЗначениеПараметра(КЗ.Значение));
			КонецЦикла;
		КонецЕсли;
		Начало = ТекущаяУниверсальнаяДатаВМиллисекундах();
		Результат = Запрос.Выполнить();
		Мс = ТекущаяУниверсальнаяДатаВМиллисекундах() - Начало;
		Колонки = Результат.Колонки;
		Выборка = Результат.Выбрать();
		Запись.ЗаписатьИмяСвойства("ms");
		Запись.ЗаписатьЗначение(Мс);
		Запись.ЗаписатьИмяСвойства("total");
		Запись.ЗаписатьЗначение(Выборка.Количество());
		Запись.ЗаписатьИмяСвойства("columns");
		Запись.ЗаписатьНачалоМассива();
		Для Каждого К Из Колонки Цикл
			Запись.ЗаписатьНачалоОбъекта();
			Запись.ЗаписатьИмяСвойства("name");
			Запись.ЗаписатьЗначение(К.Имя);
			Запись.ЗаписатьИмяСвойства("type");
			Запись.ЗаписатьЗначение(ПредставлениеТипов(К.ТипЗначения));
			Запись.ЗаписатьКонецОбъекта();
		КонецЦикла;
		Запись.ЗаписатьКонецМассива();
		Запись.ЗаписатьИмяСвойства("rows");
		Запись.ЗаписатьНачалоМассива();
		Счетчик = 0;
		Пока Счетчик < Лимит И Выборка.Следующий() Цикл
			Счетчик = Счетчик + 1;
			Запись.ЗаписатьНачалоМассива();
			Для Индекс = 0 По Колонки.Количество() - 1 Цикл
				Запись.ЗаписатьЗначение(Строка(Выборка[Индекс]));
			КонецЦикла;
			Запись.ЗаписатьКонецМассива();
		КонецЦикла;
		Запись.ЗаписатьКонецМассива();
	Исключение
		Запись.ЗаписатьИмяСвойства("error");
		Запись.ЗаписатьЗначение(КраткоеПредставлениеОшибки(ИнформацияОбОшибке()));
	КонецПопытки;
	Запись.ЗаписатьКонецОбъекта();
	Возврат Запись.Закрыть();
КонецФункции

Функция ЗначениеПараметра(Значение)
	Если ТипЗнч(Значение) = Тип("Строка") И СтрДлина(Значение) = 19 И Сред(Значение, 5, 1) = "-" И Сред(Значение, 11, 1) = "T" Тогда
		Попытка
			Возврат XMLЗначение(Тип("Дата"), Значение);
		Исключение
			Возврат Значение;
		КонецПопытки;
	ИначеЕсли ТипЗнч(Значение) = Тип("Массив") Тогда
		Список = Новый Массив;
		Для Каждого Элемент Из Значение Цикл
			Список.Добавить(ЗначениеПараметра(Элемент));
		КонецЦикла;
		Возврат Список;
	КонецЕсли;
	Возврат Значение;
КонецФункции

Функция ПредставлениеТипов(ОписаниеТипов)
	Имена = Новый Массив;
	Для Каждого Т Из ОписаниеТипов.Типы() Цикл
		Имена.Добавить(ИмяТипа(Т));
	КонецЦикла;
	Возврат СтрСоединить(Имена, ", ");
КонецФункции

// «СправочникСсылка.Номенклатура» для ссылочных типов конфигурации, иначе представление типа («Строка»).
Функция ИмяТипа(Т)
	ОбъектМД = Метаданные.НайтиПоТипу(Т);
	Если ОбъектМД <> Неопределено Тогда
		Части = СтрРазделить(ОбъектМД.ПолноеИмя(), ".");
		Если Части.Количество() = 2 Тогда
			Возврат Части[0] + "Ссылка." + Части[1];
		КонецЕсли;
	КонецЕсли;
	Возврат Строка(Т);
КонецФункции

// Метаданные для подсказок редактора — JSON в формате индекса Basehub (как разбор файла .cf).
Функция МетаданныеJSON() Экспорт
	Запись = Новый ЗаписьJSON;
	Запись.УстановитьСтроку();
	Запись.ЗаписатьНачалоОбъекта();
	Запись.ЗаписатьИмяСвойства("config_name");
	Запись.ЗаписатьЗначение(Метаданные.Имя);
	Запись.ЗаписатьИмяСвойства("config_syn");
	Запись.ЗаписатьЗначение(Метаданные.Синоним);
	Запись.ЗаписатьИмяСвойства("source");
	Запись.ЗаписатьЗначение("");
	Запись.ЗаписатьИмяСвойства("objects");
	Запись.ЗаписатьНачалоМассива();
	Виды = Новый Соответствие;
	Виды.Вставить("Справочники", "Справочник");
	Виды.Вставить("Документы", "Документ");
	Виды.Вставить("Перечисления", "Перечисление");
	Виды.Вставить("РегистрыСведений", "РегистрСведений");
	Виды.Вставить("РегистрыНакопления", "РегистрНакопления");
	Виды.Вставить("РегистрыБухгалтерии", "РегистрБухгалтерии");
	Виды.Вставить("РегистрыРасчета", "РегистрРасчета");
	Виды.Вставить("ПланыСчетов", "ПланСчетов");
	Виды.Вставить("ПланыВидовХарактеристик", "ПланВидовХарактеристик");
	Виды.Вставить("ПланыВидовРасчета", "ПланВидовРасчета");
	Виды.Вставить("БизнесПроцессы", "БизнесПроцесс");
	Виды.Вставить("Задачи", "Задача");
	Виды.Вставить("ПланыОбмена", "ПланОбмена");
	Виды.Вставить("Константы", "Константа");
	Виды.Вставить("ЖурналыДокументов", "ЖурналДокументов");
	Виды.Вставить("Отчеты", "Отчет");
	Виды.Вставить("Обработки", "Обработка");
	Для Каждого КЗ Из Виды Цикл
		Для Каждого ОбъектМД Из Метаданные[КЗ.Ключ] Цикл
			Запись.ЗаписатьНачалоОбъекта();
			Запись.ЗаписатьИмяСвойства("kind");
			Запись.ЗаписатьЗначение(КЗ.Значение);
			Запись.ЗаписатьИмяСвойства("collection");
			Запись.ЗаписатьЗначение(КЗ.Ключ);
			Запись.ЗаписатьИмяСвойства("name");
			Запись.ЗаписатьЗначение(ОбъектМД.Имя);
			Запись.ЗаписатьИмяСвойства("syn");
			Запись.ЗаписатьЗначение(ОбъектМД.Синоним);
			Запись.ЗаписатьИмяСвойства("fields");
			Запись.ЗаписатьНачалоМассива();
			Если КЗ.Ключ = "Константы" Тогда
				ЗаписатьПоле(Запись, "Значение", "", ОбъектМД.Тип);
			Иначе
				Для Каждого Коллекция Из КоллекцииПолей(КЗ.Ключ) Цикл
					Для Каждого Поле Из ОбъектМД[Коллекция] Цикл
						ЗаписатьПоле(Запись, Поле.Имя, Поле.Синоним, Поле.Тип);
					КонецЦикла;
				КонецЦикла;
			КонецЕсли;
			Запись.ЗаписатьКонецМассива();
			Запись.ЗаписатьИмяСвойства("tables");
			Запись.ЗаписатьНачалоМассива();
			Если ЕстьКоллекция(КЗ.Ключ, "ТабличныеЧасти") Тогда
				Для Каждого ТЧ Из ОбъектМД.ТабличныеЧасти Цикл
					Запись.ЗаписатьНачалоОбъекта();
					Запись.ЗаписатьИмяСвойства("name");
					Запись.ЗаписатьЗначение(ТЧ.Имя);
					Запись.ЗаписатьИмяСвойства("syn");
					Запись.ЗаписатьЗначение(ТЧ.Синоним);
					Запись.ЗаписатьИмяСвойства("fields");
					Запись.ЗаписатьНачалоМассива();
					Для Каждого Поле Из ТЧ.Реквизиты Цикл
						ЗаписатьПоле(Запись, Поле.Имя, Поле.Синоним, Поле.Тип);
					КонецЦикла;
					Запись.ЗаписатьКонецМассива();
					Запись.ЗаписатьКонецОбъекта();
				КонецЦикла;
			КонецЕсли;
			Запись.ЗаписатьКонецМассива();
			Запись.ЗаписатьИмяСвойства("values");
			Запись.ЗаписатьНачалоМассива();
			Если КЗ.Ключ = "Перечисления" Тогда
				Для Каждого Значение Из ОбъектМД.ЗначенияПеречисления Цикл
					Запись.ЗаписатьЗначение(Значение.Имя);
				КонецЦикла;
			КонецЕсли;
			Запись.ЗаписатьКонецМассива();
			Запись.ЗаписатьКонецОбъекта();
		КонецЦикла;
	КонецЦикла;
	Запись.ЗаписатьКонецМассива();
	Запись.ЗаписатьКонецОбъекта();
	Возврат Запись.Закрыть();
КонецФункции

Функция КоллекцииПолей(Коллекция)
	Если СтрНайти(Коллекция, "Регистры") = 1 Тогда
		Возврат СтрРазделить("Измерения,Ресурсы,Реквизиты", ",");
	ИначеЕсли Коллекция = "Перечисления" ИЛИ Коллекция = "ЖурналыДокументов" Тогда
		Возврат Новый Массив;
	КонецЕсли;
	Возврат СтрРазделить("Реквизиты", ",");
КонецФункции

Функция ЕстьКоллекция(Коллекция, Имя)
	Возврат СтрНайти(",Справочники,Документы,ПланыСчетов,ПланыВидовХарактеристик,ПланыВидовРасчета,БизнесПроцессы,Задачи,ПланыОбмена,Отчеты,Обработки,",
		"," + Коллекция + ",") > 0;
КонецФункции

Процедура ЗаписатьПоле(Запись, Имя, Синоним, ОписаниеТипов)
	Запись.ЗаписатьНачалоОбъекта();
	Запись.ЗаписатьИмяСвойства("name");
	Запись.ЗаписатьЗначение(Имя);
	Запись.ЗаписатьИмяСвойства("syn");
	Запись.ЗаписатьЗначение(Синоним);
	Запись.ЗаписатьИмяСвойства("types");
	Запись.ЗаписатьНачалоМассива();
	Для Каждого Т Из ОписаниеТипов.Типы() Цикл
		Запись.ЗаписатьЗначение(ИмяТипа(Т));
	КонецЦикла;
	Запись.ЗаписатьКонецМассива();
	Запись.ЗаписатьКонецОбъекта();
КонецПроцедуры

// Журнал регистрации в XML (как «Выгрузить журнал регистрации»). Отбор — JSON:
// {"from": "2026-10-17T00:00:00", "to": "…", "levels": ["E","W","I","N"], "session": 12}.
Функция ЖурналРегистрацииXML(Знач ОтборJSON = "") Экспорт
	ПроверитьПрава();
	Отбор = Новый Структура;
	Если ТипЗнч(ОтборJSON) = Тип("Строка") И ОтборJSON <> "" И ОтборJSON <> "{}" Тогда
		Чтение = Новый ЧтениеJSON;
		Чтение.УстановитьСтроку(ОтборJSON);
		Параметры = ПрочитатьJSON(Чтение, Истина);
		Чтение.Закрыть();
		Если ТипЗнч(Параметры.Получить("from")) = Тип("Строка") Тогда
			Отбор.Вставить("ДатаНачала", XMLЗначение(Тип("Дата"), Параметры.Получить("from")));
		КонецЕсли;
		Если ТипЗнч(Параметры.Получить("to")) = Тип("Строка") Тогда
			Отбор.Вставить("ДатаОкончания", XMLЗначение(Тип("Дата"), Параметры.Получить("to")));
		КонецЕсли;
		Уровни = Параметры.Получить("levels");
		Если ТипЗнч(Уровни) = Тип("Массив") И Уровни.Количество() > 0 Тогда
			Список = Новый Массив;
			Для Каждого У Из Уровни Цикл
				Если У = "E" Тогда Список.Добавить(УровеньЖурналаРегистрации.Ошибка);
				ИначеЕсли У = "W" Тогда Список.Добавить(УровеньЖурналаРегистрации.Предупреждение);
				ИначеЕсли У = "I" Тогда Список.Добавить(УровеньЖурналаРегистрации.Информация);
				ИначеЕсли У = "N" Тогда Список.Добавить(УровеньЖурналаРегистрации.Примечание);
				КонецЕсли;
			КонецЦикла;
			Отбор.Вставить("Уровень", Список);
		КонецЕсли;
		Если ТипЗнч(Параметры.Получить("session")) = Тип("Число") Тогда
			Отбор.Вставить("Сеанс", Параметры.Получить("session"));
		КонецЕсли;
	КонецЕсли;
	ИмяФайла = ПолучитьИмяВременногоФайла("xml");
	УстановитьПривилегированныйРежим(Истина);
	ВыгрузитьЖурналРегистрации(ИмяФайла, Отбор);
	УстановитьПривилегированныйРежим(Ложь);
	Текст = Новый ТекстовыйДокумент;
	Текст.Прочитать(ИмяФайла, КодировкаТекста.UTF8);
	Попытка
		УдалитьФайлы(ИмяФайла);
	Исключение
	КонецПопытки;
	Возврат Текст.ПолучитьТекст();
КонецФункции
